        {
          "name": "Task 3 - Circuit Open",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for (let attempt = 0; attempt < 3; attempt++) {\r\n    const response = await pm.sendRequest(pm.request.url.toString());\r\n    if (response.code !== 503) {\r\n        throw new Error(\"Stop storage-service before running this scenario\");\r\n    }\r\n}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Open circuit returns 503\", () => pm.response.to.have.status(503));\r\npm.test(\"Circuit-open code\", () => {\r\n    pm.expect(pm.response.json().code).to.eql(\"STORAGE_CIRCUIT_OPEN\");\r\n});"
                ]
              }
            }
          ],
